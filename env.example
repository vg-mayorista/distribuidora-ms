# ============================================================
# Distribuidora - Variables de entorno necesarias
# ============================================================
# Copiar este archivo a .env y completar con los valores reales.
# Nunca commitear .env al repositorio.

# --- Base de datos (valores default en docker-compose.yml) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/distribuidora
# SPRING_DATASOURCE_USERNAME=distribuidora
# SPRING_DATASOURCE_PASSWORD=distribuidora

# --- Twilio / WhatsApp ---
# Obtener en https://console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox de Twilio (desarrollo). En producción usar número aprobado por Meta.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Email transaccional (SMTP) ---
# Dev local: MailHog en localhost:1025 -> SPRING_MAIL_HOST=localhost
# Prod: Resend (smtp.resend.com), SendGrid, SES, etc.
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@distribuidora.com
MAIL_FROM_NAME=VG Mayorista

# --- Notification flags ---
NOTIFY_WHATSAPP_ENABLED=true
NOTIFY_EMAIL_ENABLED=true
NOTIFY_RETRY_MAX_ATTEMPTS=3
NOTIFY_RETRY_INITIAL_BACKOFF_MS=2000